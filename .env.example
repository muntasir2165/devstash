# Neon PostgreSQL — DEVELOPMENT branch connection string.
# Copy this file to `.env` and paste your Neon dev connection string below.
# Use the DIRECT (non-pooled) connection string for migrations.
# Neon requires SSL: keep `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js (NextAuth v5)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="generate-with-npx-auth-secret"

# GitHub OAuth app — create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key"
# Verified sender. onboarding@resend.dev only delivers to the Resend account owner's email.
EMAIL_FROM="DevStash <onboarding@resend.dev>"

# Base URL used to build absolute links in verification emails (falls back to the request host).
AUTH_URL="http://localhost:3000"

# Set to "false" to disable email verification: users are created already verified and no email
# is sent (handy while Resend has no verified domain). Default: enabled.
EMAIL_VERIFICATION_ENABLED="true"

# Upstash Redis (REST) — powers auth rate limiting. Create a database at
# https://console.upstash.com and copy its REST URL + token. If unset, rate
# limiting is disabled (fails open) and the app still runs.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""